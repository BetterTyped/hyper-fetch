	"children": [
		{
			"id": 5540,
			"name": "HonoAppToHyperFetch",
			"variant": "declaration",
			"kind": 2097152,
			"flags": {},
			"comment": {
				"summary": [
					{
						"kind": "text",
						"text": "Converts the type of a Hono app into a Hyper Fetch SDK schema for "
					},
					{
						"kind": "code",
						"text": "`createSdk`"
					},
					{
						"kind": "text",
						"text": ".\n\nEvery route becomes a "
					},
					{
						"kind": "code",
						"text": "`Request`"
					},
					{
						"kind": "text",
						"text": " whose response, JSON payload, query params and endpoint come\nfrom the Hono route definition and its validators. Path segments become nested properties,\n"
					},
					{
						"kind": "code",
						"text": "`:param`"
					},
					{
						"kind": "text",
						"text": " segments become "
					},
					{
						"kind": "code",
						"text": "`$param`"
					},
					{
						"kind": "text",
						"text": " properties, and kebab-case segments become camelCase.\n\nPass the type of the app returned by your route chain, including apps mounted with\n"
					},
					{
						"kind": "code",
						"text": "`app.route()`"
					},
					{
						"kind": "text",
						"text": " and "
					},
					{
						"kind": "code",
						"text": "`basePath()`"
					},
					{
						"kind": "text",
						"text": ". Anything that is not a Hono app resolves to "
					},
					{
						"kind": "code",
						"text": "`{}`"
					},
					{
						"kind": "text",
						"text": "."
					}
				],
				"blockTags": [
					{
						"tag": "@example",
						"content": [
							{
								"kind": "code",
								"text": "```ts\n// backend\nconst app = new Hono().get(\"/users/:userId\", (c) => c.json({ id: c.req.param(\"userId\") }));\nexport type AppSchema = HonoAppToHyperFetch<typeof app>;\n\n// frontend\nconst sdk = createSdk<typeof client, AppSchema>(client);\nconst { data } = await sdk.users.$userId.$get.send({ params: { userId: \"1\" } });\n```"
							}
						]
					}
				]
			},
