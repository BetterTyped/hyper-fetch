			"comment": {
				"summary": [
					{
						"kind": "text",
						"text": "Reports typos and unknown keys in the generic passed to "
					},
					{
						"kind": "code",
						"text": "`createClient<{ ... }>()`"
					},
					{
						"kind": "text",
						"text": ".\n\nOnly "
					},
					{
						"kind": "code",
						"text": "`createClient`"
					},
					{
						"kind": "text",
						"text": " imported from "
					},
					{
						"kind": "code",
						"text": "`@hyper-fetch/core`"
					},
					{
						"kind": "text",
						"text": " is checked, by name, alias or namespace\n("
					},
					{
						"kind": "code",
						"text": "`import * as HF`"
					},
					{
						"kind": "text",
						"text": " then "
					},
					{
						"kind": "code",
						"text": "`HF.createClient`"
					},
					{
						"kind": "text",
						"text": "). Files that do not mention both "
					},
					{
						"kind": "code",
						"text": "`@hyper-fetch/core`"
					},
					{
						"kind": "text",
						"text": " and\n"
					},
					{
						"kind": "code",
						"text": "`createClient`"
					},
					{
						"kind": "text",
						"text": " are skipped before oxlint deserializes their AST, which is where nearly all of the\nrule's cost would go."
					}
				]
			},
