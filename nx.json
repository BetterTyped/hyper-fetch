{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "inputs": ["default", "^default"]
    }
  },
  "workspaceLayout": {
    "appsDir": "examples",
    "libsDir": "packages"
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true,
        "style": "css",
        "linter": "none",
        "bundler": "vite"
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "css",
        "linter": "none"
      }
    },
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "none"
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/next/plugin",
      "options": {
        "startTargetName": "start",
        "buildTargetName": "next:build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "testTargetName": "test",
        "serveTargetName": "vite:serve",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static"
      }
    }
  ],
  "parallel": 1,
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "release": {
    "projects": ["packages/*", "!hyper-flow", "!testing"],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "conventionalCommits": {
      "types": {
        "perf": {
          "semverBump": "patch"
        },
        "revert": {
          "semverBump": "patch"
        }
      }
    },
    "version": {
      "specifierSource": "conventional-commits",
      "currentVersionResolver": "git-tag",
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      },
      "preserveMatchingDependencyRanges": false,
      "git": {
        "commit": false,
        "tag": false,
        "push": false,
        "stageChanges": false
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": false,
      "git": {
        "commit": false,
        "tag": false,
        "push": false,
        "stageChanges": false
      }
    }
  },
  "analytics": false
}
