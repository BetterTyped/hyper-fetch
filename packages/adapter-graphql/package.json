{
  "name": "@hyper-fetch/graphql",
  "version": "0.0.0",
  "description": "GraphQL adapters for HyperFetch: typed queries and mutations over HTTP, subscriptions over WebSocket with graphql-ws",
  "author": "Maciej Pyrc <maciekpyrc@gmail.com>, Kacper Skawina <kacper.skawina@gmail.com>",
  "homepage": "https://hyperfetch.bettertyped.com/docs/integrations/adapter-graphql/overview/",
  "license": "Apache-2.0",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts"
      },
      "default": {
        "require": "./dist/index.mjs",
        "import": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "start": "pnpm build && npx run-when-changed --watch 'src/**/*.ts' --exec 'pnpm build'",
    "build": "vite build",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "typecheck": "tsgo --noEmit --emitDeclarationOnly false && tsgo --noEmit -p __tests__/tsconfig.json",
    "tests": "pnpm lint-staged"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterTyped/hyper-fetch.git",
    "directory": "packages/adapter-graphql"
  },
  "bugs": {
    "url": "https://github.com/BetterTyped/hyper-fetch/issues"
  },
  "peerDependencies": {
    "@hyper-fetch/core": "*",
    "@hyper-fetch/sockets": "*",
    "graphql": "^15.0.0 || ^16.0.0"
  },
  "devDependencies": {
    "abortcontroller-polyfill": "^1.7.5",
    "graphql": "^16.13.2",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^6.0.0",
    "ws": "^8.18.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "vitest related --run --passWithNoTests"
    ]
  },
  "keywords": [
    "graphql",
    "graphql-client",
    "apollo-alternative",
    "subscriptions",
    "graphql-ws",
    "websocket",
    "typescript",
    "hyperfetch"
  ]
}
