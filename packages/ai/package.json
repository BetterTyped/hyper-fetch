{
  "name": "@hyper-fetch/ai",
  "version": "0.0.0",
  "description": "Provider-agnostic, end-to-end typed AI chat client for HyperFetch - works with AI SDK, TanStack AI and any AG-UI backend",
  "author": "Maciej Pyrc <maciekpyrc@gmail.com>, Kacper Skawina <kacper.skawina@gmail.com>",
  "homepage": "https://hyperfetch.bettertyped.com/",
  "license": "Apache-2.0",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts"
      },
      "default": {
        "require": "./dist/index.mjs",
        "import": "./dist/index.mjs"
      }
    },
    "./react": {
      "types": {
        "import": "./dist/react/index.d.ts"
      },
      "default": {
        "require": "./dist/react.mjs",
        "import": "./dist/react.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "start": "pnpm build && npx run-when-changed --watch 'src/**/*.ts' --exec 'pnpm build'",
    "build": "vite build",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "typecheck": "tsgo --noEmit --emitDeclarationOnly false && tsgo --noEmit -p __tests__/tsconfig.json",
    "tests": "pnpm lint-staged",
    "release": "pnpm semantic-release --extends ../../release.config.js -t 'hyper-fetch-ai-v${version}'"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterTyped/hyper-fetch.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/BetterTyped/hyper-fetch/issues"
  },
  "peerDependencies": {
    "@hyper-fetch/core": "*",
    "react": ">= 18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/ai": "1.4.0",
    "ai": "7.0.173",
    "zod": "^3.25.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "vitest related --run --passWithNoTests"
    ]
  },
  "keywords": [
    "ai",
    "llm",
    "chat",
    "useChat",
    "useObject",
    "streaming",
    "sse",
    "ai-sdk",
    "tanstack-ai",
    "ag-ui",
    "hyper-fetch",
    "react"
  ]
}
