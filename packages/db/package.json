{
  "name": "@hyper-fetch/db",
  "version": "0.0.0",
  "description": "Collections and live queries for Hyper Fetch: one source of truth for data from requests and sockets",
  "author": "Maciej Pyrc <maciekpyrc@gmail.com>, Kacper Skawina <kacper.skawina@gmail.com>",
  "homepage": "https://hyperfetch.bettertyped.com/",
  "license": "Apache-2.0",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts"
      },
      "default": {
        "require": "./dist/index.mjs",
        "import": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "start": "pnpm build && npx run-when-changed --watch 'src/**/*.ts' --exec 'pnpm build'",
    "build": "vite build",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "typecheck": "tsgo --noEmit --emitDeclarationOnly false && tsgo --noEmit -p __tests__/tsconfig.json && node scripts/type-budget.mjs",
    "tests": "pnpm lint-staged"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterTyped/hyper-fetch.git",
    "directory": "packages/db"
  },
  "bugs": {
    "url": "https://github.com/BetterTyped/hyper-fetch/issues"
  },
  "peerDependencies": {
    "@hyper-fetch/core": "*",
    "@hyper-fetch/sockets": "*"
  },
  "peerDependenciesMeta": {
    "@hyper-fetch/sockets": {
      "optional": true
    }
  },
  "devDependencies": {
    "ws": "^8.18.0",
    "zod": "^4.4.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "vitest related --run --passWithNoTests"
    ]
  },
  "keywords": [
    "database",
    "collections",
    "live queries",
    "normalized cache",
    "optimistic updates",
    "offline",
    "sync",
    "typescript"
  ]
}
