{
  "name": "@hyper-fetch/react",
  "version": "0.0.0",
  "description": "React hooks for HyperFetch: useFetch, useSubmit, caching, mutations, optimistic updates, infinite queries and realtime",
  "author": "Maciej Pyrc <maciekpyrc@gmail.com>, Kacper Skawina <kacper.skawina@gmail.com>",
  "homepage": "https://hyperfetch.bettertyped.com/docs/react/overview/",
  "license": "Apache-2.0",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts"
      },
      "default": {
        "require": "./dist/index.mjs",
        "import": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "start": "pnpm build && npx run-when-changed --watch 'src/**/*.ts' --exec 'pnpm build'",
    "build": "vite build",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "typecheck": "tsgo --noEmit --emitDeclarationOnly false && tsgo --noEmit -p __tests__/tsconfig.json",
    "tests": "pnpm lint-staged"
  },
  "peerDependencies": {
    "@hyper-fetch/core": "*",
    "@hyper-fetch/db": "*",
    "@hyper-fetch/sockets": "*",
    "react": ">= 18.0.0"
  },
  "peerDependenciesMeta": {
    "@hyper-fetch/db": {
      "optional": true
    },
    "@hyper-fetch/sockets": {
      "optional": true
    }
  },
  "dependencies": {
    "@better-hooks/lifecycle": "^2.0.0",
    "@better-hooks/performance": "^2.1.0"
  },
  "devDependencies": {
    "@hyper-fetch/db": "workspace:*"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "vitest related --run --passWithNoTests"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterTyped/hyper-fetch.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/BetterTyped/hyper-fetch/issues"
  },
  "keywords": [
    "react",
    "react-hooks",
    "data-fetching",
    "react-query-alternative",
    "swr-alternative",
    "useFetch",
    "useSubmit",
    "mutations",
    "cache",
    "optimistic-updates",
    "infinite-scroll",
    "websocket",
    "sse",
    "typescript",
    "hyperfetch"
  ]
}
