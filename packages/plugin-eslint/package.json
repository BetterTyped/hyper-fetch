{
  "name": "eslint-plugin-hyper-fetch",
  "version": "0.0.0",
  "description": "ESLint plugin for HyperFetch: checks the generic types passed to createClient and createRequest, so a typo fails lint",
  "author": "Maciej Pyrc <maciekpyrc@gmail.com>, Kacper Skawina <kacper.skawina@gmail.com>",
  "homepage": "https://hyperfetch.bettertyped.com/docs/integrations/plugin-eslint/",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "start": "pnpm build && npx run-when-changed --watch 'src/**/*.ts' --exec 'pnpm build'",
    "build": "vite build",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "typecheck": "tsgo --noEmit --emitDeclarationOnly false && tsgo --noEmit -p __tests__/tsconfig.json",
    "tests": "pnpm lint-staged"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.73.0"
  },
  "peerDependencies": {
    "@hyper-fetch/core": "*",
    "@hyper-fetch/sockets": "*",
    "eslint": ">=8.57.0",
    "react": ">= 16.8.0"
  },
  "peerDependenciesMeta": {
    "@hyper-fetch/sockets": {
      "optional": true
    },
    "eslint": {
      "optional": false
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript-eslint/rule-tester": "^8.73.0",
    "assert": "2.1.0",
    "eslint": "10.15.0",
    "eslint-v8": "npm:eslint@8.57.1",
    "path": "0.12.7",
    "typescript-eslint-parser-v7": "npm:@typescript-eslint/parser@7.18.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "vitest related --run --passWithNoTests"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterTyped/hyper-fetch.git",
    "directory": "packages/plugin-eslint"
  },
  "bugs": {
    "url": "https://github.com/BetterTyped/hyper-fetch/issues"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "lint",
    "typescript",
    "hyperfetch"
  ]
}
