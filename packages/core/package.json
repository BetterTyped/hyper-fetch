{
  "name": "@hyper-fetch/core",
  "version": "0.0.0",
  "description": "Type-safe data fetching for TypeScript: typed requests, caching, retries, deduplication, offline queues and adapters",
  "author": "Maciej Pyrc <maciekpyrc@gmail.com>, Kacper Skawina <kacper.skawina@gmail.com>",
  "homepage": "https://hyperfetch.bettertyped.com/docs/core/overview/",
  "license": "Apache-2.0",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "start": "pnpm build && npx run-when-changed --watch 'src/**/*.ts' --exec 'pnpm build'",
    "build": "vite build",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "typecheck": "tsgo --noEmit --emitDeclarationOnly false && tsgo --noEmit -p __tests__/tsconfig.json && tsgo --noEmit -p __tests__/type-stress/custom-adapter/tsconfig.json",
    "tests": "pnpm lint-staged"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterTyped/hyper-fetch.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/BetterTyped/hyper-fetch/issues"
  },
  "dependencies": {
    "events": "^3.3.0"
  },
  "devDependencies": {
    "abortcontroller-polyfill": "^1.7.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "vitest related --run --passWithNoTests"
    ]
  },
  "keywords": [
    "data-fetching",
    "fetch",
    "http-client",
    "api-client",
    "typescript",
    "type-safe",
    "cache",
    "retry",
    "deduplication",
    "offline",
    "queue",
    "request",
    "rest",
    "sdk",
    "hyperfetch"
  ]
}
