{
  "name": "@hyper-fetch/trpc",
  "version": "0.0.0",
  "description": "tRPC adapter for Hyper Fetch",
  "author": "Maciej Pyrc <maciekpyrc@gmail.com>, Kacper Skawina <kacper.skawina@gmail.com>",
  "homepage": "https://hyperfetch.bettertyped.com/",
  "license": "Apache-2.0",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts"
      },
      "default": {
        "require": "./dist/index.mjs",
        "import": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "start": "pnpm build && npx run-when-changed --watch 'src/**/*.ts' --exec 'pnpm build'",
    "build": "vite build",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "typecheck": "tsgo --noEmit --emitDeclarationOnly false && tsgo --noEmit -p __tests__/tsconfig.json",
    "tests": "pnpm lint-staged"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterTyped/hyper-fetch.git",
    "directory": "packages/adapter-trpc"
  },
  "bugs": {
    "url": "https://github.com/BetterTyped/hyper-fetch/issues"
  },
  "peerDependencies": {
    "@hyper-fetch/core": "*",
    "@trpc/server": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@trpc/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "abortcontroller-polyfill": "^1.7.5",
    "superjson": "^2.2.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "vitest related --run --passWithNoTests"
    ]
  },
  "keywords": [
    "fetch",
    "requests",
    "js",
    "fetcher",
    "trpc",
    "rpc",
    "typescript",
    "end-to-end-types"
  ]
}
