# Copy to .env.local and fill in the web app config from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Or run the Firestore emulator instead (`npx firebase-tools emulators:start --only firestore --project demo-hyper-fetch`)
# and set only these two:
# VITE_FIREBASE_PROJECT_ID=demo-hyper-fetch
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1:8080
